# =============================================================================
# Lemuria Park — environment template (never commit real secrets)
# =============================================================================

# development | test | production
NODE_ENV="development"

# local | staging | production (staging forces site-wide noindex + strict secrets)
DEPLOY_ENV="local"

# PostgreSQL — separate DB per environment (never point staging at production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6432/lemuria?sslmode=require"

# Public origin (staging/production MUST be HTTPS, not localhost)
NEXT_PUBLIC_APP_URL="https://stage.lemuriapark.ru"

# Auth / signing — min 32 chars in staging/production; never ChangeMe / replace-with
AUTH_SECRET="replace-with-32+-char-secret"
QR_SIGNING_SECRET="replace-with-32+-char-secret"
CASHIER_SESSION_SECRET="replace-with-32+-char-secret"

# Cron cleanup: Authorization: Bearer $CRON_SECRET  →  POST /api/cron/cleanup
# Required in staging/production (min 32 chars)
CRON_SECRET="replace-with-32+-char-cron-secret"

# Payment: none | yookassa (empty/none = honest AWAITING_PAYMENT, no fake success)
PAYMENT_PROVIDER="none"
YUKASSA_SHOP_ID=""
YUKASSA_SECRET_KEY=""
# Staging webhook: https://stage.lemuriapark.ru/api/webhooks/yookassa

# Email: none | yandex_postbox (none = NOT_CONFIGURED, never claim "sent")
EMAIL_PROVIDER="none"
EMAIL_FROM="tickets@lemuriapark.ru"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_API_ENDPOINT=""
EMAIL_API_KEY=""

# Optional monitoring DSN (ConsoleErrorReporter until SDK wired)
ERROR_MONITORING_DSN=""

# -----------------------------------------------------------------------------
# Staging bootstrap ONLY (scripts/staging-bootstrap.ts) — never commit values
# -----------------------------------------------------------------------------
# STAGING_OWNER_EMAIL=
# STAGING_OWNER_PASSWORD=
# STAGING_OWNER_NAME=
# STAGING_DIRECTOR_EMAIL=
# STAGING_DIRECTOR_PASSWORD=
# STAGING_DIRECTOR_NAME=
# STAGING_CASHIER_EMAIL=
# STAGING_CASHIER_PASSWORD=
# STAGING_CASHIER_NAME=
# STAGING_LOCATION_SLUG=krasnodar-stage
