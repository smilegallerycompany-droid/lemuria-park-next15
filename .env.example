# PostgreSQL — Yandex Managed Service for PostgreSQL (RU region, port 6432)
# Production cluster currently uses database db1 / user user1 (do not rename).
# Staging: database lemuria_staging / user lemuria_staging_app on the same cluster.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6432/db1?sslmode=require"
# Production Serverless: omit DATABASE_URL and pass non-secret parts plus Lockbox DB_PASSWORD.
# container-bootstrap.cjs assembles DATABASE_URL in-process (never logs it).
# DB_HOST="rc1a-xxxx.mdb.yandexcloud.net"
# DB_PORT="6432"
# DB_NAME="db1"
# DB_USER="user1"
# DB_PASSWORD=""
# DB_SSLMODE="require"
# Cap Prisma connections per Serverless instance (default 1 in production).
PRISMA_CONNECTION_LIMIT="1"

# Public site URL (custom domain on Yandex Cloud / API Gateway)
NEXT_PUBLIC_APP_URL="https://lemuriapark.ru"

# Comma-separated Host allowlist. Required in production. Health probes are exempt.
ALLOWED_HOSTS="lemuriapark.ru,www.lemuriapark.ru,cashier.lemuriapark.ru,admin.lemuriapark.ru,owner.lemuriapark.ru"

# staging | production | empty (local). Staging forces noindex.
APP_ENV=""

# Never set these in production. container-bootstrap.cjs exits if APP_ENV is not staging.
# RUN_MIGRATE_ON_START=1
# RUN_STAGING_SEED_ON_START=1
# ALLOW_STAGING_SEED=1

# Auth / signing (set strong values in production)
AUTH_SECRET="replace-with-32+-char-secret"
QR_SIGNING_SECRET="replace-with-32+-char-secret"
CASHIER_SESSION_SECRET="replace-with-32+-char-secret"
CRON_SECRET="replace-with-32+-char-secret"

# ЮKassa — Russian acquiring, works without VPN
# Leave empty in local/dev: checkout stays AWAITING_PAYMENT (no fake success)
YUKASSA_SHOP_ID=""
YUKASSA_SECRET_KEY=""
# Webhook URL to configure in ЮKassa cabinet:
# https://YOUR_DOMAIN/api/webhooks/yookassa

# Yandex Object Storage (S3-compatible). Leave empty → local/dev storage.
YANDEX_STORAGE_ENDPOINT=""
YANDEX_STORAGE_BUCKET=""
YANDEX_STORAGE_ACCESS_KEY=""
YANDEX_STORAGE_SECRET_KEY=""
YANDEX_STORAGE_PUBLIC_BASE_URL=""

# Yandex Cloud Postbox (email). Until configured — email is NOT sent (honest).
EMAIL_PROVIDER="none"
EMAIL_FROM="tickets@lemuriapark.ru"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_API_ENDPOINT=""
EMAIL_API_KEY=""

# Optional error monitoring DSN (ConsoleErrorReporter today; no Sentry SDK required)
ERROR_MONITORING_DSN=""

# Optional Yandex Maps JS API key for public LocationMap (fallback card if empty)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=""
