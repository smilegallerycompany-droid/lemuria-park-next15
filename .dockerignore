# Build context hygiene — never bake secrets or local state into the image.
.git
.github
.gitignore
.env
.env.*
!.env.example
node_modules
.next
out
dist
coverage
tmp
.tmp-screenshots
test-results
playwright-report
docs/qa-screenshots
docs/screenshots
**/*.tsbuildinfo
*.md
!README.md
.editorconfig
.prettierrc
.eslintrc*
eslint.config.*
playwright.config.ts
e2e
src/**/*.test.ts
src/**/*.concurrency.test.ts
Dockerfile*
docker-compose*
.vscode
.idea
.DS_Store
agent-transcripts
