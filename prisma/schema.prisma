generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  OWNER
  ADMIN
  DIRECTOR
  CASHIER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum LocationStatus {
  UPCOMING
  ACTIVE
  PAUSED
  CLOSED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PriceDayType {
  WEEKDAY
  WEEKEND
}

enum SessionStatus {
  SCHEDULED
  OPEN
  CLOSED
  CANCELLED
  COMPLETED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  EXPIRED
}

enum OrderSource {
  ONLINE
  CASHIER
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD_ONLINE
  CARD_TERMINAL
  CASH
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum CheckInResult {
  SUCCESS
  ALREADY_USED
  INVALID
  CANCELLED
  EXPIRED
}

enum RefundStatus {
  PENDING
  /// Legacy success status — treat as SUCCEEDED in queries.
  COMPLETED
  REJECTED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum CashierShiftStatus {
  OPEN
  CLOSED
  FORCE_CLOSED
}

enum CashOperationType {
  OPENING
  SALE
  REFUND
  IN
  OUT
  CLOSING
  ADJUSTMENT
}

enum TicketDeliveryStatus {
  SENT
  FAILED
  NOT_CONFIGURED
}

// ---------------------------------------------------------------------------
// Staff & audit
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(CASHIER)
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  locations        UserLocation[]
  staffSessions    StaffSession[]
  cashierOrders    Order[]          @relation("OrderCashier")
  cashierPayments  Payment[]        @relation("PaymentCashier")
  checkIns         TicketCheckIn[]  @relation("CheckInStaff")
  auditLogs        AuditLog[]       @relation("AuditActor")
  refunds          Refund[]         @relation("RefundActor")
  printLogs        PrintLog[]       @relation("PrintActor")
  ticketDeliveries TicketDelivery[] @relation("DeliveryActor")
  cashierShifts    CashierShift[]   @relation("ShiftCashier")
  cashOperations   CashOperation[]  @relation("CashOpUser")

  @@index([role])
  @@index([status])
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, locationId])
  @@index([locationId])
  @@index([userId])
}

model StaffSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  /// Client IP at session creation.
  ip        String?
  /// User-Agent at session creation.
  ua        String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Locations & schedule (supports sequential touring between cities)
// ---------------------------------------------------------------------------

model Location {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  name                   String
  city                   String
  address                String
  /// Floor / landmark / extra orientation line for public map section.
  addressLine2           String?
  timezone               String         @default("Europe/Moscow")
  status                 LocationStatus @default(UPCOMING)
  defaultCapacity        Int            @default(15)
  sessionIntervalMinutes Int            @default(30)
  /// Visit duration in minutes. Internal only — must never be exposed via public API.
  visitDurationMinutes   Int            @default(20)
  activeFrom             DateTime?
  activeTo               DateTime?
  phone                  String?
  email                  String?
  /// External route deep-link (Yandex / 2GIS / Google). Prefer over inventing routes.
  mapUrl                 String?
  routeUrl               String?
  latitude               Float?
  longitude              Float?
  mapZoom                Int            @default(16)
  mapLabel               String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  schedules     LocationSchedule[]
  priceRules    PriceRule[]
  sessions      Session[]
  galleryItems  GalleryItem[]
  userLocations UserLocation[]
  orders        Order[]
  cashierShifts CashierShift[]

  @@index([status])
  @@index([city])
}

model LocationSchedule {
  id                     String    @id @default(cuid())
  locationId             String
  location               Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  dayOfWeek              DayOfWeek
  opensAt                String
  closesAt               String
  sessionIntervalMinutes Int?
  isClosed               Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([locationId, dayOfWeek])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Ticket types & pricing (fully data-driven, no hardcoded prices/types)
// ---------------------------------------------------------------------------

model TicketType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  minAge      Int?
  maxAge      Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  priceRules       PriceRule[]
  reservationItems ReservationItem[]
  orderItems       OrderItem[]
  tickets          Ticket[]

  @@index([isActive, sortOrder])
}

model PriceRule {
  id           String       @id @default(cuid())
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  dayType      PriceDayType
  /// Price in whole kopecks (1/100 RUB).
  priceAmount  Int
  currency     String       @default("RUB")
  validFrom    DateTime     @default(now())
  validTo      DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([locationId, ticketTypeId, dayType, validFrom])
  @@index([locationId, ticketTypeId, dayType, isActive])
}

// ---------------------------------------------------------------------------
// Sessions
// ---------------------------------------------------------------------------

model Session {
  id         String        @id @default(cuid())
  publicId   String        @unique @default(cuid())
  locationId String
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Restrict)
  startsAt   DateTime
  endsAt     DateTime
  /// Overrides Location.defaultCapacity for this specific session.
  capacity   Int
  status     SessionStatus @default(SCHEDULED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  reservations Reservation[]
  orders       Order[]
  tickets      Ticket[]

  @@unique([locationId, startsAt])
  @@index([locationId, startsAt])
  @@index([status, startsAt])
}

// ---------------------------------------------------------------------------
// Reservations (temporary seat holds before an order/payment exists)
// ---------------------------------------------------------------------------

model Reservation {
  id                     String            @id @default(cuid())
  publicId               String            @unique @default(cuid())
  sessionId              String
  session                Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status                 ReservationStatus @default(PENDING)
  expiresAt              DateTime
  customerName           String?
  customerPhone          String?
  customerEmail          String?
  idempotencyKey         String?           @unique
  /// Hash of the request payload that created this reservation, so a repeated
  /// Idempotency-Key with a *different* payload can be rejected (IDEMPOTENCY_CONFLICT).
  idempotencyPayloadHash String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  items ReservationItem[]
  order Order?

  @@index([sessionId, status])
  @@index([status, expiresAt])
}

model ReservationItem {
  id              String      @id @default(cuid())
  reservationId   String
  reservation     Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ticketTypeId    String
  ticketType      TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  quantity        Int
  /// Price snapshot at reservation time (kopecks), so the quoted hold price is stable.
  unitPriceAmount Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([reservationId, ticketTypeId])
  @@index([reservationId])
}

// ---------------------------------------------------------------------------
// Orders (online checkout or cashier walk-up sale)
// ---------------------------------------------------------------------------

model Order {
  id                     String        @id @default(cuid())
  /// Safe, human-friendly identifier to show the customer (e.g. "LP-000123").
  number                 String        @unique
  sessionId              String
  session                Session       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  /// Denormalized from session for director/cashier filtering. Optional for legacy rows.
  locationId             String?
  location               Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  reservationId          String?       @unique
  reservation            Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  status                 OrderStatus   @default(DRAFT)
  source                 OrderSource   @default(ONLINE)
  customerName           String
  customerPhone          String
  customerEmail          String
  /// Total in kopecks, always computed server-side.
  totalAmount            Int
  currency               String        @default("RUB")
  idempotencyKey         String?       @unique
  /// Hash of the request payload that created this order, so a repeated
  /// Idempotency-Key with a *different* payload can be rejected (IDEMPOTENCY_CONFLICT)
  /// instead of silently returning an unrelated order.
  idempotencyPayloadHash String?
  /// Own deadline for paying an AWAITING_PAYMENT order — independent of the
  /// originating Reservation's `expiresAt`. An order past this deadline is
  /// swept to EXPIRED and stops occupying seats (see OrderCleanupService).
  paymentExpiresAt       DateTime?
  cashierId              String?
  cashier                User?         @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  shiftId                String?
  shift                  CashierShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items          OrderItem[]
  payments       Payment[]
  tickets        Ticket[]
  refunds        Refund[]
  deliveries     TicketDelivery[]
  printLogs      PrintLog[]
  cashOperations CashOperation[]

  @@index([sessionId, status])
  @@index([locationId])
  @@index([status])
  @@index([source])
  @@index([status, paymentExpiresAt])
  @@index([shiftId])
}

model OrderItem {
  id              String     @id @default(cuid())
  orderId         String
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketTypeId    String
  ticketType      TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  /// Snapshot of the ticket type name at the time of purchase.
  ticketTypeName  String
  quantity        Int
  /// Snapshot of unit price in kopecks — later price changes never affect this order.
  unitPriceAmount Int
  /// Snapshot of quantity * unitPriceAmount in kopecks.
  subtotalAmount  Int
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tickets Ticket[]

  @@unique([orderId, ticketTypeId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  /// Amount in kopecks.
  amount            Int
  currency          String        @default("RUB")
  provider          String?
  providerPaymentId String?       @unique
  idempotencyKey    String?       @unique
  confirmationUrl   String?
  payload           Json?
  cashierId         String?
  cashier           User?         @relation("PaymentCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  refunds           Refund[]

  @@index([orderId, status])
  @@index([status])
}

/// Financial refund history — never delete rows; mark status instead.
model Refund {
  id               String       @id @default(cuid())
  publicId         String       @unique @default(cuid())
  orderId          String
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentId        String?
  payment          Payment?     @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  /// Amount in kopecks.
  amount           Int
  status           RefundStatus @default(PENDING)
  reason           String?
  actorId          String?
  actor            User?        @relation("RefundActor", fields: [actorId], references: [id], onDelete: SetNull)
  providerRefundId String?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model TicketDelivery {
  id           String               @id @default(cuid())
  orderId      String
  order        Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  channel      String
  toAddress    String
  status       TicketDeliveryStatus
  errorMessage String?
  actorId      String?
  actor        User?                @relation("DeliveryActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([orderId])
  @@index([createdAt])
}

model PrintLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?    @relation("PrintActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// cashier | director | admin | system
  source    String   @default("cashier")
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([ticketId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Cashier shifts & cash journal
// ---------------------------------------------------------------------------

model CashierShift {
  id                   String             @id @default(cuid())
  publicId             String             @unique @default(cuid())
  userId               String
  user                 User               @relation("ShiftCashier", fields: [userId], references: [id], onDelete: Restrict)
  locationId           String
  location             Location           @relation(fields: [locationId], references: [id], onDelete: Restrict)
  status               CashierShiftStatus @default(OPEN)
  openedAt             DateTime           @default(now())
  closedAt             DateTime?
  openingCashAmount    Int                @default(0)
  closingCashAmount    Int?
  expectedCashAmount   Int?
  cashDifferenceAmount Int?
  cashSalesAmount      Int                @default(0)
  cardSalesAmount      Int                @default(0)
  onlineSalesAmount    Int                @default(0)
  cashRefundsAmount    Int                @default(0)
  ordersCount          Int                @default(0)
  ticketsCount         Int                @default(0)
  notes                String?
  closeReason          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  orders         Order[]
  cashOperations CashOperation[]

  @@index([userId, status])
  @@index([locationId, status])
  @@index([openedAt])
  @@index([status])
}

model CashOperation {
  id        String            @id @default(cuid())
  shiftId   String
  shift     CashierShift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation("CashOpUser", fields: [userId], references: [id], onDelete: Restrict)
  type      CashOperationType
  /// Signed amount in kopecks (OUT is stored negative or positive with type=OUT — use type).
  amount    Int
  comment   String?
  orderId   String?
  order     Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt DateTime          @default(now())

  @@index([shiftId, createdAt])
  @@index([type])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Tickets & check-ins
// ---------------------------------------------------------------------------

model Ticket {
  id           String       @id @default(cuid())
  publicId     String       @unique @default(cuid())
  orderId      String
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItemId  String
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  sessionId    String
  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  ticketTypeId String
  ticketType   TicketType   @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  status       TicketStatus @default(VALID)
  /// Opaque/signed token embedded in the ticket QR code.
  qrToken      String       @unique
  usedAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  checkIns  TicketCheckIn[]
  printLogs PrintLog[]

  @@index([orderId])
  @@index([sessionId, status])
  @@index([status])
}

model TicketCheckIn {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  result      CheckInResult
  scannedById String?
  scannedBy   User?         @relation("CheckInStaff", fields: [scannedById], references: [id], onDelete: SetNull)
  scannedAt   DateTime      @default(now())
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([ticketId])
  @@index([scannedAt])
}

// ---------------------------------------------------------------------------
// Public content, settings & contacts (DB-driven, never hardcoded)
// ---------------------------------------------------------------------------

model SiteSettings {
  id                     String   @id @default(cuid())
  siteName               String   @default("Лемурия Парк")
  siteSubtitle           String   @default("Зоотеатр лемуров")
  ctaLabel               String   @default("Купить билет")
  defaultSessionInterval Int      @default(30)
  defaultCapacity        Int      @default(15)
  sessionGenerationDays  Int      @default(60)
  maintenanceMode        Boolean  @default(false)
  metaTitle              String?
  metaDescription        String?
  heroBadge              String?
  heroTitle              String?
  heroSubtitle           String?
  heroDescription        String?
  heroImageUrl           String?
  heroCtaLabel           String?
  heroCtaHref            String?  @default("#booking")
  heroActive             Boolean  @default(true)
  aboutEyebrow           String?
  aboutTitle             String?
  aboutDescription       String?
  /// Zod-validated array of { title, description, iconKey, sortOrder, isActive }
  aboutBenefits          Json?
  locationSectionTitle   String?  @default("Где мы находимся?")
  defaultTimezone        String   @default("Europe/Moscow")
  supportPhone           String?
  supportEmail           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model ContactSettings {
  id              String   @id @default(cuid())
  phone           String
  complaintsPhone String?
  email           String?
  supportHours    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model FaqItem {
  id          String   @id @default(cuid())
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

model GalleryItem {
  id            String       @id @default(cuid())
  locationId    String?
  location      Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  mediaObjectId String?
  mediaObject   MediaObject? @relation(fields: [mediaObjectId], references: [id], onDelete: SetNull)
  imageUrl      String
  altText       String
  caption       String?
  sortOrder     Int          @default(0)
  isPublished   Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([isPublished, sortOrder])
  @@index([locationId])
  @@index([mediaObjectId])
}

/// Operational signals for admin system health (no secrets).
model OperationalEvent {
  id        String   @id @default(cuid())
  kind      String
  status    String
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

/// Media metadata — store URL/key only, never base64 blobs in DB.
model MediaObject {
  id           String        @id @default(cuid())
  key          String        @unique
  url          String
  mimeType     String?
  byteSize     Int?
  width        Int?
  height       Int?
  altText      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  galleryItems GalleryItem[]

  @@index([createdAt])
}
